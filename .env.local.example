# Copy this file to .env.local for local development, and add the same
# keys/values in your host's Environment Variables settings (e.g. Vercel
# Project Settings → Environment Variables) for production.
#
# .env.local is already gitignored — never commit real secrets.

# --- Admin portal login (/admin/login) ---------------------------------
# Pick a long, random password — it also signs your login session, so
# nothing extra is needed to enable "log out" (see README).
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long-and-random

# --- GitHub — lets /admin commit writeups + images to your repo -------
# 1. Create a token at https://github.com/settings/tokens
#    - Fine-grained token, scoped to just this repository, with
#      "Contents: Read and write" permission. (Classic tokens with the
#      "repo" scope work too, but are broader than necessary.)
# 2. Fill in the repo it should commit to below.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main
